{
  "name": "family-passport-local-backend",
  "private": true,
  "version": "0.1.0",
  "dependencies": {
    "google-auth-library": "10.5.0",
    "nodemailer": "9.0.5"
  },
  "scripts": {
    "supabase": "supabase",
    "start": "powershell -ExecutionPolicy Bypass -File scripts/start.ps1",
    "stop": "powershell -ExecutionPolicy Bypass -File scripts/stop.ps1",
    "status": "powershell -ExecutionPolicy Bypass -File scripts/status.ps1",
    "test:isolated": "node scripts/test-isolated.mjs",
    "migrate": "powershell -ExecutionPolicy Bypass -File scripts/apply-migrations.ps1",
    "test:auth": "node scripts/test-isolated.mjs email-password-auth.mjs",
    "test:foundation": "node scripts/test-isolated.mjs family-foundation.mjs",
    "test:mfa": "node scripts/test-isolated.mjs totp-mfa-e2e.mjs",
    "test:google-auth": "node scripts/test-isolated.mjs google-oauth-contract.mjs",
    "test:google-drive": "node scripts/test-isolated.mjs google-drive-exact-files.sql",
    "test:operations": "node scripts/test-isolated.mjs operational-hardening.sql",
    "inbox:send": "powershell -ExecutionPolicy Bypass -File scripts/send-synthetic-inbox-email.ps1",
    "inbox:ingest": "node email-ingestion/worker.mjs",
    "inbox:watch": "node email-ingestion/worker.mjs --watch",
    "attachments:scan": "node email-ingestion/attachment-scanner.mjs",
    "attachments:watch": "node email-ingestion/attachment-scanner.mjs --watch",
    "classifications:run": "node email-ingestion/classifier.mjs",
    "classifications:watch": "node email-ingestion/classifier.mjs --watch",
    "document-analysis:run": "node document-analysis/worker.mjs",
    "document-analysis:watch": "node document-analysis/worker.mjs --watch",
    "telegram:run": "node telegram/worker.mjs",
    "telegram:watch": "node telegram/worker.mjs --watch",
    "test:telegram": "node --test tests/telegram-worker.test.mjs",
    "test:document-analysis": "node --test tests/document-analysis-worker.test.mjs",
    "test:relative-date": "node --test tests/relative-date.test.mjs",
    "notifications:run": "node notifications/worker.mjs",
    "notifications:watch": "node notifications/worker.mjs --watch",
    "search:serve": "node search-assistant/server.mjs",
    "test:inbox-ingestion": "node scripts/test-isolated.mjs email-ingestion-e2e.mjs",
    "test:attachment-scanner": "node scripts/test-isolated.mjs attachment-scanner-e2e.mjs",
    "test:search": "node scripts/test-isolated.mjs search-assistant-e2e.mjs",
    "test:e2e": "node scripts/test-isolated.mjs ocr-reminder-e2e.mjs"
  },
  "devDependencies": {
    "supabase": "2.115.0"
  }
}
