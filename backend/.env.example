# Copy to .env.local. Never commit real secret values.
POSTGRES_PASSWORD=replace-with-a-long-random-value
GOTRUE_JWT_SECRET=replace-with-at-least-32-random-characters
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_APP_ID=
# Generate exactly 32 random bytes and store their base64 form here. Never commit it.
GOOGLE_DRIVE_TOKEN_KEY=
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@familydocuments.servicehub.co.nz
INGESTION_HMAC_SECRET=generate-a-separate-random-32-byte-or-longer-secret
INGESTION_HOST=inbound-familydocuments.servicehub.co.nz
API_HOST=api-familydocuments.servicehub.co.nz
FRONTEND_ORIGIN=https://familydocuments.app
SMTP_FROM_NAME=Family Documents
RESEND_API_KEY=
FP_NOTIFICATION_FROM=Family Passport <notifications@example.com>
FP_NOTIFICATION_INTERVAL_SECONDS=300
# Phase 1B document-analysis worker uses the existing local services.
FP_OCR_URL=http://127.0.0.1:55323
FP_OLLAMA_URL=http://127.0.0.1:11434
FP_OLLAMA_MODEL=qwen3:4b
# Optional Phase 2E customer-facing Telegram transport. Keep real values in
# the approved secret store or untracked environment file only.
TELEGRAM_BOT_IDENTITY=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org
FP_GATEWAY_URL=http://127.0.0.1:55327
